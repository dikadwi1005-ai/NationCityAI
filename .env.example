# Set a long random admin key before starting. Never prefix with NEXT_PUBLIC_.
ADMIN_KEY=replace-with-at-least-24-random-characters
# Absolute directory on a persistent volume; defaults to ./data
# WORLD_DATA_DIR=/absolute/path/data

# Proximity radius in virtual metres (0 < CHAT_RADIUS <= 1000).
# CHAT_RADIUS=120
# VISIBILITY_RADIUS=180

# Private recovery: configure outside checkout and public directories.
# BACKUP_DIR=/private/nation/vault
# BACKUP_INTERVAL_HOURS=24
# BACKUP_DAILY=7
# BACKUP_WEEKLY=4
# BACKUP_MONTHLY=3
# BACKUP_KEY: supply from server secret manager (32 bytes, Base64).
# BACKUP_S3_BUCKET and AWS_REGION: dedicated private bucket and region.
# VOTER_MIN_AGE_HOURS=0
# NEXT_PUBLIC_GOV_TIMEZONE=Asia/Jakarta
