# Configure these through Railway Variables; do not commit filled copies.
NATION_ENV=staging
NATION_DB=postgres
CLOSED_BETA=true
DATABASE_URL=
WEB_ORIGIN=
MULTIPLAYER_PUBLIC_URL=
BETA_USERNAMES=
BETA_INVITE_KEY=
ADMIN_KEY=
# Only backup worker / controlled migration job:
BACKUP_S3_BUCKET=
AWS_REGION=
BACKUP_KEY=
BACKUP_INTERVAL_HOURS=12
# Use IAM limited to this bucket/prefix. Use platform secret injection for AWS credentials.
# Only an operator migration/drill process receives the owner URLs:
MIGRATION_DATABASE_URL=
MIGRATION_TARGET_DATABASE=
MIGRATION_SOURCE=
RUNTIME_DB_ROLE=nation_app
# Only set true after every source writer has stopped for cutover.
MIGRATION_WRITES_FROZEN=false
RESTORE_DATABASE_URL=
RESTORE_TARGET_DATABASE=
